# Custom flags for TWRP/OrangeFox interface

/modem          emmc    /dev/block/bootdevice/by-name/modem         flags=slotselect;display="Modem (Baseband)";backup=1
/bluetooth      emmc    /dev/block/bootdevice/by-name/bluetooth     flags=slotselect;display="Bluetooth";backup=1
/dsp            emmc    /dev/block/bootdevice/by-name/dsp           flags=slotselect;display="DSP";backup=1
/efs1           emmc    /dev/block/bootdevice/by-name/modemst1      flags=display="EFS Part 1";backup=1
/efs2           emmc    /dev/block/bootdevice/by-name/modemst2      flags=display="EFS Part 2";backup=1
/efsc           emmc    /dev/block/bootdevice/by-name/fsc           flags=display="EFS Control";backup=1
/efsg           emmc    /dev/block/bootdevice/by-name/fsg           flags=display="EFS Group";backup=1

# External Storage Removable
/external_sd    auto    /dev/block/mmcblk0p1   /dev/block/mmcblk0   flags=display="Micro SDcard";storage;wipeingui;removable
